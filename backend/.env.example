# Copia este fichero a .env y ajusta los valores.
PIZARRA_DEBUG=false

# PostgreSQL. La base de desarrollo la levanta docker-compose.dev.yml.
PIZARRA_DATABASE_URL=postgresql+psycopg://pizarra:pizarra@localhost:5432/pizarra

# Base usada por los tests (se vacía entre test y test).
PIZARRA_TEST_DATABASE_URL=postgresql+psycopg://pizarra:pizarra@localhost:5432/pizarra_test

PIZARRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pool de conexiones
PIZARRA_DB_POOL_SIZE=5
PIZARRA_DB_MAX_OVERFLOW=10
