# Copia este fichero a .env y ajusta los valores. Aquí sólo van marcadores:
# este fichero SÍ está en git, así que nunca pongas credenciales reales.
PIZARRA_DEBUG=false

# PostgreSQL. En local lo levanta docker-compose.dev.yml; en producción es la
# cadena "Session pooler" de Supabase, con el esquema cambiado a
# postgresql+psycopg:// para que SQLAlchemy use psycopg 3.
PIZARRA_DATABASE_URL=postgresql+psycopg://pizarra:pizarra@localhost:5432/pizarra
# PIZARRA_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

PIZARRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pool de conexiones. Contra el pooler de Supabase, valores bajos (3 / 2).
PIZARRA_DB_POOL_SIZE=5
PIZARRA_DB_MAX_OVERFLOW=10

# API de Supabase (aún sin usar en el código).
SUPABASE_URL=https://meegkpvoyeihfsgpderc.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_UevVxJ492TJazjIwdB-eHA_W9ypF4Xy
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://meegkpvoyeihfsgpderc.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PASSWORD=
