# Build del frontend apuntando al backend desplegado en Render.
#   npm run build:render
#
# Sólo lo carga `vite build --mode render`, de modo que el build por defecto
# (el que usa el Dockerfile) sigue hablando por rutas relativas contra nginx.
VITE_API_BASE_URL=https://pizarra-estrategia.onrender.com/api
